{
  "name": "oh-my-query",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.2.2",
      "zod": "^4.1.13",
      "@typescript/native-preview": "beta"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "dev:native": "turbo -F native dev",
    "dev:web": "turbo -F web dev",
    "desktop:dev": "turbo -F web desktop:dev",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "fixtures:up": "docker compose -f infra/docker-compose.yaml up -d postgres",
    "fixtures:down": "docker compose -f infra/docker-compose.yaml stop postgres",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@oh-my-query/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@oh-my-query/config": "workspace:*",
    "@typescript/native-preview": "catalog:",
    "lefthook": "^2.1.6",
    "oxfmt": "latest",
    "oxlint": "latest",
    "turbo": "^2.6.3",
    "ultracite": "7.1.5"
  },
  "packageManager": "bun@1.3.9"
}
