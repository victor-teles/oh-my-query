{
  "compilerOptions": {
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "noCheck": true,
    "skipLibCheck": true,
    "types": ["bun"],
    "rootDir": "./.hutch/devkit/api",
    "outDir": "./.hutch/types"
  },
  "files": [
    "./.hutch/devkit/api/sdks/main/index.ts",
    "./.hutch/devkit/api/browser/index.ts"
  ]
}
