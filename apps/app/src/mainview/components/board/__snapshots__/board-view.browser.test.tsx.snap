// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`boardView states > explains an empty board 1`] = `
<main
  class="min-h-0 flex-1 overflow-y-auto px-6 pt-5 pb-10"
>
  <div
    class="flex flex-col items-center gap-3 pt-[18vh] text-center"
  >
    <p
      class="type-title text-[15px] text-foreground"
    >
      Add widgets from the launcher
    </p>
    <p
      class="flex flex-wrap items-center justify-center gap-1.5 type-meta text-panel-muted"
    >
      Open a widget with 
      <kbd
        aria-label="⌥ ⇧ Space"
        class="inline-flex items-center gap-0.5"
        data-slot="kbd-group"
      >
        <kbd
          class="pointer-events-none inline-flex h-5 min-w-5 items-center justify-center rounded-[5px] bg-kbd px-1 font-sans type-micro text-panel-muted select-none [&_svg:not([class*='size-'])]:size-3"
          data-slot="kbd"
        >
          ⌥
        </kbd>
        <kbd
          class="pointer-events-none inline-flex h-5 min-w-5 items-center justify-center rounded-[5px] bg-kbd px-1 font-sans type-micro text-panel-muted select-none [&_svg:not([class*='size-'])]:size-3"
          data-slot="kbd"
        >
          ⇧
        </kbd>
        <kbd
          class="pointer-events-none inline-flex h-5 min-w-5 items-center justify-center rounded-[5px] bg-kbd px-1 font-sans type-micro text-panel-muted select-none [&_svg:not([class*='size-'])]:size-3"
          data-slot="kbd"
        >
          Space
        </kbd>
      </kbd>
      , then
      <kbd
        aria-label="⌘ K"
        class="inline-flex items-center gap-0.5"
        data-slot="kbd-group"
      >
        <kbd
          class="pointer-events-none inline-flex h-5 min-w-5 items-center justify-center rounded-[5px] bg-kbd px-1 font-sans type-micro text-panel-muted select-none [&_svg:not([class*='size-'])]:size-3"
          data-slot="kbd"
        >
          ⌘
        </kbd>
        <kbd
          class="pointer-events-none inline-flex h-5 min-w-5 items-center justify-center rounded-[5px] bg-kbd px-1 font-sans type-micro text-panel-muted select-none [&_svg:not([class*='size-'])]:size-3"
          data-slot="kbd"
        >
          K
        </kbd>
      </kbd>
       → Add to Board
    </p>
  </div>
</main>
`;

