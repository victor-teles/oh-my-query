exports[`widgetRunView states > explains an empty result 1`] = `
<div
  data-testid="run-harness"
  style="width: 760px"
>
  <div
    aria-label="Revenue by region"
    class="flex min-h-0 flex-col outline-none has-[[data-active=true]]:min-h-[356px]"
    role="group"
    tabindex="-1"
  >
    <div
      id="widget-run-header"
    >
      <div
        class="relative z-20 flex h-14 shrink-0 items-center gap-2.5 px-4"
      >
        <div
          class="flex min-w-0 flex-1 items-center"
        >
          <div
            class="flex min-w-0 flex-1 items-center gap-2.5"
          >
            <h2
              class="max-w-[40%] shrink-0 truncate type-input text-foreground"
            >
              Revenue by region
            </h2>
            <div
              aria-label="Revenue by region inputs"
              class="flex min-w-0 items-center gap-1.5"
              role="group"
            >
              <span
                class="relative inline-flex h-7 shrink-0 items-center gap-1.5 rounded-[8px] bg-row-hover px-2"
                data-active="false"
              >
                <span
                  aria-hidden="true"
                  class="relative type-micro text-panel-muted"
                >
                  Region
                </span>
                <span
                  class="relative flex min-w-0 items-center"
                >
                  <input
                    aria-autocomplete="list"
                    aria-controls="arg-options-region"
                    aria-expanded="false"
                    aria-label="Region"
                    autocomplete="off"
                    class="max-w-48 min-w-[3ch] bg-transparent type-body text-foreground outline-none focus-visible:outline-none"
                    role="combobox"
                    size="6"
                    spellcheck="false"
                    value="Europe"
                  />
                </span>
              </span>
              <span
                class="relative inline-flex h-7 shrink-0 items-center gap-1.5 rounded-[8px] bg-row-hover px-2"
                data-active="false"
              >
                <span
                  aria-hidden="true"
                  class="relative type-micro text-panel-muted"
                >
                  Period
                </span>
                <span
                  class="relative flex min-w-0 items-center"
                >
                  <button
                    aria-controls="arg-presets-period"
                    aria-expanded="false"
                    aria-haspopup="listbox"
                    aria-label="Period: Last quarter"
                    class="flex items-center gap-1 type-body text-foreground outline-none focus-visible:outline-none"
                    type="button"
                  >
                    <span
                      class="max-w-56 truncate"
                    >
                      Last quarter
                    </span>
                    <svg
                      aria-hidden="true"
                      class="lucide lucide-chevron-down size-3 text-panel-muted"
                      fill="none"
                      height="24"
                      stroke="currentColor"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      viewBox="0 0 24 24"
                      width="24"
                      xmlns="http://www.w3.org/2000/svg"
                    >
                      <path
                        d="m6 9 6 6 6-6"
                      />
                    </svg>
                  </button>
                </span>
              </span>
            </div>
          </div>
        </div>
        <button
          aria-label="Run"
          class="grid size-7 shrink-0 place-items-center bg-row-hover text-panel-muted hover:text-foreground"
          style="border-radius: 8px"
          tabindex="0"
          type="button"
        >
          <span
            class="grid place-items-center"
          >
            <svg
              aria-hidden="true"
              class="lucide lucide-corner-down-left size-3.5"
              fill="none"
              height="24"
              stroke="currentColor"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              viewBox="0 0 24 24"
              width="24"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path
                d="M20 4v7a4 4 0 0 1-4 4H4"
              />
              <path
                d="m9 10-5 5 5 5"
              />
            </svg>
          </span>
        </button>
      </div>
    </div>
    <div
      class="relative flex min-h-0 flex-1 flex-col overflow-y-auto border-t border-panel-border"
      style="min-height: 0px"
    >
      <div
        class="flex h-8 shrink-0 items-center gap-2 px-4 type-meta text-panel-muted tabular-nums"
      >
        <span
          aria-hidden="true"
          class="grid place-items-center bg-row-hover size-4 rounded-[5px] text-[10px]"
        >
          🐘
        </span>
        <span
          class="truncate"
        >
          analytics
        </span>
        <span
          aria-hidden="true"
        >
          ·
        </span>
        <span
          data-slot="swap-text"
        >
          <span
            class="inline-block"
          >
            0 rows · 386 ms
          </span>
        </span>
      </div>
      <div
