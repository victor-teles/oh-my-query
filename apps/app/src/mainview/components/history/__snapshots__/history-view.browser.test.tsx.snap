exports[`historyView > asks for every stored ask and groups them by day 1`] = `
<div
  aria-label="Past asks"
  class="relative flex flex-col gap-1 px-2 pb-2"
  id="launcher-history-list"
  role="listbox"
>
  <div>
    <div
      aria-labelledby="_r_id_"
      role="group"
    >
      <div
        class="px-2.5 pt-1 pb-1.5 type-micro text-panel-muted"
        id="_r_id_"
      >
        Today
      </div>
      <div
        data-motion="stagger"
      >
        <div
          aria-selected="true"
          class="relative flex h-10 cursor-default items-center gap-3 px-2.5"
          data-tone="default"
          id="launcher-option-a-signups"
          role="option"
          tabindex="0"
        >
          <div
            class="absolute inset-0 rounded-[10px] bg-row-active"
          />
          <span
            class="relative grid size-6 place-items-center rounded-[7px] bg-row-hover text-panel-muted"
          >
            <svg
              aria-hidden="true"
              class="lucide lucide-history size-3.5"
              fill="none"
              height="24"
              stroke="currentColor"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              viewBox="0 0 24 24"
              width="24"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path
                d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"
