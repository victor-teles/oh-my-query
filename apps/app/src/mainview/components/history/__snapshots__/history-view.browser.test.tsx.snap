exports[`historyView > says when nothing matches 1`] = `
<div
  class="flex flex-col items-center gap-1 px-6 pt-5 pb-6 text-center"
>
  <p
    class="type-body text-foreground"
    role="status"
  >
    Nothing matches “zzzz”
  </p>
  <p
    class="type-meta text-panel-muted"
  >
    Try another word from the question, the card title or the SQL.
  </p>
</div>
`;

exports[`historyView > says when there is no history yet 1`] = `
<div
  class="flex flex-col items-center gap-1 px-6 pt-5 pb-6 text-center"
>
  <p
    class="type-body text-foreground"
    role="status"
  >
    No asks yet.
  </p>
  <p
    class="type-meta text-panel-muted"
  >
    Ask a question from the launcher and it shows up here.
  </p>
</div>
`;

exports[`historyView > shows an error with Retry 1`] = `
<div
  class="flex flex-col items-center gap-2 px-6 pt-5 pb-6 text-center"
>
  <p
    class="type-body text-foreground"
    role="alert"
  >
    History couldn’t load.
  </p>
  <button
    class="rounded-[7px] bg-row-hover px-2.5 py-1 type-meta text-foreground focus-visible:ring-1 focus-visible:ring-primary/60 focus-visible:outline-none"
    tabindex="0"
    type="button"
  >
    Retry
  </button>
</div>
`;
