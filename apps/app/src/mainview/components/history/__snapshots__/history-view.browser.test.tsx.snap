          </span>
          <span
            class="relative flex min-w-0 flex-1 items-baseline gap-2"
          >
            <span
              class="min-w-0 flex-1 truncate type-body text-foreground"
            >
              Signups by plan, EU only
            </span>
            <span
              class="max-w-[55%] min-w-0 truncate type-meta text-panel-muted"
            >
              <span>
                analytics
              </span>
               · Signups by plan · 14:05
            </span>
          </span>
        </div>
      </div>
      <div
        data-motion="stagger"
      >
        <div
          aria-selected="false"
          class="relative flex h-10 cursor-default items-center gap-3 px-2.5"
          data-tone="default"
          id="launcher-option-a-revenue"
          role="option"
          tabindex="0"
        >
          <span
            class="relative grid size-6 place-items-center rounded-[7px] bg-row-hover text-panel-muted"
          >
            <svg
