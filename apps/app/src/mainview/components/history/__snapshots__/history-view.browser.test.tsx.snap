            >
              <path
                d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"
              />
              <path
                d="M3 3v5h5"
              />
              <path
                d="M12 7v5l4 2"
              />
            </svg>
          </span>
          <span
            class="relative flex min-w-0 flex-1 items-baseline gap-2"
          >
            <span
              class="min-w-0 flex-1 truncate type-body text-foreground"
            >
              Revenue for Europe
            </span>
            <span
              class="max-w-[55%] min-w-0 truncate type-meta text-panel-muted"
            >
              <span>
                analytics
              </span>
               · Monthly recurring revenue in Europe · 09:30
            </span>
          </span>
        </div>
      </div>
    </div>
  </div>
  <div>
    <div
      aria-labelledby="_r_id_"
