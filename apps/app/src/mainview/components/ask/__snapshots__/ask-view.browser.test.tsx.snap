            </span>
          </button>
        </div>
      </div>
      <div>
        <div
          aria-label="Generated SQL"
          class="max-h-[220px] overflow-y-auto px-2 py-2 font-mono text-[12px] leading-[19px] outline-none focus-visible:ring-2 focus-visible:ring-ring/60 h-[220px]"
          data-state="streaming"
          role="region"
          tabindex="0"
        >
          <div
            class="relative flex"
          >
            <span
              aria-hidden="true"
              class="w-9 shrink-0 pr-3 text-right text-panel-muted tabular-nums select-none"
            >
