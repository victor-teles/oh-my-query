                />
              </svg>
            </span>
          </button>
          <span
            aria-live="polite"
            class="sr-only"
          />
          <button
            aria-expanded="true"
            aria-label="Hide SQL"
            class="grid size-6 place-items-center rounded-[6px] text-panel-muted hover:bg-row-hover hover:text-foreground disabled:opacity-40"
            tabindex="0"
            type="button"
          >
            <span
