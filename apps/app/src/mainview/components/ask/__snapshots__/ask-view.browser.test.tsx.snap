exports[`askView designed states > matches the snapshot for writing SQL 1`] = `
<div
  data-testid="ask-harness"
  style="width: 760px"
>
  <div
    class="flex min-h-0 flex-col"
  >
    <div
      class="relative z-20 flex h-14 shrink-0 items-center gap-2.5 px-4"
    >
      <span
        aria-label="Active connection: analytics"
        class="relative flex h-8 max-w-56 shrink-0 items-center pr-2.5 pl-1"
        data-tone="active"
        role="img"
      >
        <span
          class="absolute inset-0 rounded-[9px] bg-row-hover"
        />
        <span
          class="relative flex min-w-0 items-center gap-3"
        >
          <span
            aria-hidden="true"
            class="grid size-6 place-items-center rounded-[7px] text-[13px] leading-none bg-row-hover"
          >
            🐘
          </span>
          <span
            class="truncate type-body text-foreground"
          >
            analytics
          </span>
        </span>
      </span>
      <div
        class="flex min-w-0 flex-1 items-center"
      >
        <div
          class="relative flex min-w-0 flex-1 items-center"
        >
          <input
            aria-label="Ask a question"
            aria-placeholder="Ask about your data…"
            autocomplete="off"
            class="min-w-0 flex-1 bg-transparent type-input text-foreground outline-none placeholder:text-panel-muted placeholder:opacity-80 focus-visible:outline-none"
            spellcheck="false"
            type="text"
            value="Revenue by region"
          />
          <div
            aria-hidden="true"
            class="pointer-events-none absolute inset-0 flex items-center overflow-hidden type-input"
          />
        </div>
      </div>
      <button
        aria-label="Stop"
        class="grid size-7 shrink-0 place-items-center bg-row-hover text-panel-muted hover:text-foreground"
        style="border-radius: 6px"
        tabindex="0"
        type="button"
      >
        <span
          class="grid place-items-center"
        >
          <svg
            aria-hidden="true"
            class="lucide lucide-square size-3 fill-current"
            fill="none"
            height="24"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            viewBox="0 0 24 24"
            width="24"
            xmlns="http://www.w3.org/2000/svg"
          >
            <rect
              height="18"
              rx="2"
              width="18"
              x="3"
              y="3"
            />
          </svg>
        </span>
      </button>
    </div>
    <div
      class="relative flex min-h-0 flex-1 flex-col overflow-y-auto border-t border-panel-border"
      style="min-height: 0px"
    >
      <div
        class="flex h-9 shrink-0 items-center gap-2 px-4"
      >
        <svg
          aria-hidden="true"
          class="lucide lucide-database size-3.5 shrink-0 text-panel-muted"
          fill="none"
          height="24"
          stroke="currentColor"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          viewBox="0 0 24 24"
          width="24"
          xmlns="http://www.w3.org/2000/svg"
        >
          <ellipse
            cx="12"
            cy="5"
            rx="9"
            ry="3"
          />
          <path
            d="M3 5V19A9 3 0 0 0 21 19V5"
          />
          <path
            d="M3 12A9 3 0 0 0 21 12"
          />
        </svg>
        <h2
          class="type-meta font-semibold text-foreground"
        >
          Generated SQL
        </h2>
        <p
          class="flex min-w-0 items-center gap-1.5 truncate type-meta text-panel-muted tabular-nums"
        >
          <span
            aria-hidden="true"
          >
            ·
          </span>
          <span
            data-slot="swap-text"
          >
            <span
              class="inline-block"
            >
              PostgreSQL
            </span>
          </span>
          <span
            aria-hidden="true"
          >
            ·
          </span>
          <span
            data-slot="swap-text"
          >
            <span
              class="inline-block"
            >
              analytics
            </span>
          </span>
        </p>
        <div
          class="ml-auto flex items-center gap-0.5"
        >
          <span
            class="grid size-5 place-items-center"
          >
            <span
              class="grid place-items-center"
            >
              <span
                aria-label="Working"
                class="block size-1.5 rounded-full bg-panel-muted"
                role="img"
              />
            </span>
          </span>
          <button
            aria-label="Copy SQL"
            class="grid size-6 place-items-center rounded-[6px] text-panel-muted hover:bg-row-hover hover:text-foreground disabled:opacity-40"
            tabindex="0"
            type="button"
          >
            <span>
              <svg
                aria-hidden="true"
