  </script>
  <div
    style="width: 760px"
  >
    <div
      class="flex min-h-0 flex-col"
    >
      <header
        class="flex h-14 shrink-0 items-center gap-2 px-3"
      >
        <button
          aria-label="Back"
          class="grid size-7 place-items-center rounded-[8px] text-panel-muted hover:bg-row-hover hover:text-foreground"
          tabindex="0"
          type="button"
        >
          <svg
            aria-hidden="true"
            class="lucide lucide-chevron-left size-4"
            fill="none"
            height="24"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            viewBox="0 0 24 24"
            width="24"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              d="m15 18-6-6 6-6"
            />
          </svg>
        </button>
        <h1
          class="min-w-0 flex-1 truncate type-title text-foreground"
        >
          Import Widgets and Boards
        </h1>
      </header>
      <div
        class="relative flex min-h-0 flex-1 flex-col border-t border-panel-border"
      >
        <div
          class="flex min-h-0 flex-col"
        >
          <div
            class="flex flex-col gap-3 px-4 pt-3 pb-4"
          >
            <p
              class="flex items-center gap-2 type-body text-foreground"
              role="status"
            >
              <svg
                aria-label="Imported"
                class="size-3.5 text-success-ink"
                fill="none"
                role="img"
                viewBox="0 0 16 16"
              >
                <path
                  d="M3.5 8.5 6.5 11.5 12.5 4.5"
                  pathLength="1"
                  stroke="currentColor"
                  stroke-dasharray="1 1"
                  stroke-dashoffset="0"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="1.75"
                />
              </svg>
              Imported 1 widget and 1 board.
            </p>
            <button
              class="h-7 self-start rounded-[7px] bg-row-hover px-2.5 type-meta text-foreground hover:bg-row-active focus-visible:ring-2 focus-visible:ring-ring/60 focus-visible:outline-none"
              tabindex="0"
              type="button"
            >
              Done
            </button>
          </div>
        </div>
      </div>
      <footer
        class="flex h-9 shrink-0 items-center justify-between gap-3 border-t border-panel-border px-4 type-meta text-panel-muted"
      >
        <div
          class="flex min-w-0 items-center gap-2"
        >
          <span
            class="flex min-w-0 items-center"
            role="status"
          />
        </div>
        <div
          class="flex shrink-0 items-center gap-3"
        >
          <div
            class="flex items-center gap-2"
          >
            <span
              class="text-foreground"
              data-slot="swap-text"
            >
              <span
                class="inline-block"
              >
                Done
              </span>
            </span>
            <kbd
              aria-label="↩"
              class="inline-flex items-center gap-0.5"
              data-slot="kbd-group"
            >
              <kbd
                class="pointer-events-none inline-flex h-5 min-w-5 items-center justify-center rounded-[5px] bg-kbd px-1 font-sans type-micro text-panel-muted select-none [&_svg:not([class*='size-'])]:size-3"
                data-slot="kbd"
              >
                ↩
              </kbd>
            </kbd>
          </div>
        </div>
      </footer>
    </div>
  </div>
</div>
`;

