  >
    <span
      aria-hidden="true"
      class="absolute inset-0 rounded-[8px] bg-primary/12 ring-1 ring-primary/55"
    />
    <span
      aria-hidden="true"
      class="relative type-micro text-panel-muted"
    >
      Region
    </span>
    <span
      class="relative flex min-w-0 items-center"
    >
      <input
        aria-autocomplete="list"
        aria-controls="arg-options-region"
        aria-expanded="true"
        aria-label="Region"
        autocomplete="off"
        class="max-w-48 min-w-[3ch] bg-transparent type-body text-foreground outline-none focus-visible:outline-none"
        role="combobox"
        size="6"
        spellcheck="false"
        value="Europe"
      />
    </span>
    <div
      class="absolute top-full left-0 z-30 mt-2 flex w-60 flex-col rounded-[12px] popover-material p-1"
    >
      <div
        aria-label="Region options"
        id="arg-options-region"
        role="listbox"
      >
        <div
          aria-selected="false"
          class="relative flex h-7 cursor-default items-center px-2 type-body text-foreground"
          role="option"
        >
          <span
            class="relative truncate"
          >
            Asia Pacific
          </span>
        </div>
        <div
          aria-selected="true"
          class="relative flex h-7 cursor-default items-center px-2 type-body text-foreground"
          role="option"
        >
          <span
            class="absolute inset-0 rounded-[6px] bg-row-active"
          />
          <span
            class="relative truncate"
          >
            Europe
          </span>
        </div>
        <div
          aria-selected="false"
          class="relative flex h-7 cursor-default items-center px-2 type-body text-foreground"
          role="option"
        >
          <span
            class="relative truncate"
          >
            North America
          </span>
        </div>
      </div>
    </div>
  </span>
  <span
    class="relative inline-flex h-7 shrink-0 items-center gap-1.5 rounded-[8px] bg-row-hover px-2"
    data-active="false"
  >
    <span
      aria-hidden="true"
      class="relative type-micro text-panel-muted"
    >
      Period
    </span>
    <span
      class="relative flex min-w-0 items-center"
    >
      <button
        aria-controls="arg-presets-period"
        aria-expanded="false"
        aria-haspopup="listbox"
        aria-label="Period: Last quarter"
        class="flex items-center gap-1 type-body text-foreground outline-none focus-visible:outline-none"
        type="button"
      >
        <span
          class="max-w-56 truncate"
        >
          Last quarter
        </span>
        <svg
          aria-hidden="true"
          class="lucide lucide-chevron-down size-3 text-panel-muted"
          fill="none"
          height="24"
          stroke="currentColor"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          viewBox="0 0 24 24"
          width="24"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path
            d="m6 9 6 6 6-6"
          />
        </svg>
      </button>
    </span>
  </span>
</div>
`;

