      >
        Any model your provider serves.
      </span>
    </div>
    <div
      class="flex shrink-0 items-center"
    >
      <div
        class="flex flex-col items-end gap-1.5"
      >
        <input
          aria-label="Model"
          autocapitalize="off"
          autocomplete="off"
          autocorrect="off"
          class="h-7 w-60 rounded-[8px] border border-panel-border bg-row-hover px-2.5 font-mono text-[12px] text-foreground outline-none placeholder:font-sans placeholder:text-panel-muted focus-visible:border-ring focus-visible:ring-2 focus-visible:ring-ring/40"
          data-1p-ignore="true"
          placeholder="claude-opus-5-5 (default)"
          spellcheck="false"
          value=""
        />
        <div
          class="flex flex-wrap justify-end gap-0.5"
        >
          <button
            aria-pressed="true"
            class="h-6 rounded-[6px] px-2 font-mono text-[11px] bg-row-active text-foreground"
            tabindex="0"
            type="button"
          >
            claude-opus-5-5
          </button>
          <button
            aria-pressed="false"
            class="h-6 rounded-[6px] px-2 font-mono text-[11px] text-panel-muted hover:bg-row-hover hover:text-foreground"
            tabindex="0"
            type="button"
          >
            claude-sonnet-5-5
          </button>
          <button
            aria-pressed="false"
            class="h-6 rounded-[6px] px-2 font-mono text-[11px] text-panel-muted hover:bg-row-hover hover:text-foreground"
            tabindex="0"
            type="button"
          >
            claude-haiku-5-5
          </button>
        </div>
      </div>
    </div>
  </div>
  <div
    class="flex min-h-14 items-center justify-between gap-6 px-4 py-2.5"
  >
    <div
      class="flex min-w-0 flex-col gap-0.5"
    >
      <span
        class="type-body text-foreground"
      >
        API key
      </span>
      <span
        class="type-meta text-panel-muted"
      >
        Encrypted on this Mac. Never shown again.
      </span>
    </div>
    <div
      class="flex shrink-0 items-center"
    >
      <div
        class="flex items-center gap-1"
      >
        <span
          aria-label="Stored API key"
          class="mr-1.5 font-mono text-[12px] text-panel-muted"
          role="img"
        >
          •••• a1b2
        </span>
        <button
          class="h-7 rounded-[8px] px-2.5 type-meta text-foreground hover:bg-row-hover"
          tabindex="0"
          type="button"
        >
          Replace
        </button>
        <button
          class="h-7 rounded-[8px] px-2.5 type-meta text-foreground hover:bg-row-hover"
          tabindex="0"
          type="button"
        >
          Clear
        </button>
      </div>
    </div>
  </div>
  <div
    class="flex items-center gap-2 px-4 py-3"
  >
    <span
      class="flex-1"
    />
    <button
      class="h-7 rounded-[8px] px-3 type-meta disabled:pointer-events-none disabled:opacity-50 text-foreground hover:bg-row-hover"
      tabindex="0"
      type="button"
    >
      Test
    </button>
    <button
      class="h-7 rounded-[8px] px-3 type-meta disabled:pointer-events-none disabled:opacity-50 bg-primary text-primary-foreground"
      disabled=""
      tabindex="0"
      type="submit"
    >
      <span
        data-slot="swap-text"
      >
        <span
          class="inline-block"
        >
          Save
        </span>
      </span>
    </button>
  </div>
</form>
`;

