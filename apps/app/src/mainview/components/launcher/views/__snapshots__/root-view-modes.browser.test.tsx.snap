// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`connection mode > dims the active chip while choosing 1`] = `
<div
  aria-label="Results"
  class="flex flex-col gap-1 px-2 pb-2"
  id="launcher-root-list"
  role="listbox"
>
  <div
    aria-labelledby="_r_id_"
    role="group"
  >
    <div
      class="px-2.5 pt-1 pb-1.5 type-micro text-panel-muted"
      id="_r_id_"
    >
      Switch connection
    </div>
    <div
      aria-selected="true"
      class="relative flex h-10 cursor-default items-center gap-3 px-2.5"
      data-tone="default"
      id="launcher-option-analytics"
      role="option"
      tabindex="0"
    >
      <div
        class="absolute inset-0 rounded-[10px] bg-row-active"
      />
      <span
        class="relative flex min-w-0 items-center gap-3 max-w-[45%] shrink-0"
      >
        <span
          aria-hidden="true"
          class="grid size-6 place-items-center rounded-[7px] text-[13px] leading-none bg-row-hover"
        >
          🐘
        </span>
        <span
          class="truncate type-body text-foreground"
        >
          analytics
        </span>
      </span>
      <span
        aria-live="polite"
        class="relative min-w-0 flex-1 overflow-hidden type-meta whitespace-nowrap text-panel-muted"
        title="PostgreSQL · localhost/analytics"
      >
        <span
          data-slot="swap-text"
        >
          <span
            class="inline-block"
          >
            PostgreSQL · localhost/analytics
          </span>
        </span>
      </span>
      <span
        class="relative grid size-4 shrink-0 place-items-center"
      />
    </div>
    <div
      aria-selected="false"
      class="relative flex h-10 cursor-default items-center gap-3 px-2.5"
      data-tone="default"
      id="launcher-option-billing"
      role="option"
