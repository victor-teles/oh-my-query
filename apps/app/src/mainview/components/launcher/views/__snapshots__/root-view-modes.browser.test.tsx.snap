      >
        <span
          data-slot="swap-text"
        >
          <span
            class="inline-block"
          >
            PostgreSQL · localhost/analytics
          </span>
        </span>
      </span>
      <span
        class="relative grid size-4 shrink-0 place-items-center"
      />
    </div>
    <div
      aria-selected="false"
      class="relative flex h-10 cursor-default items-center gap-3 px-2.5"
      data-tone="default"
      id="launcher-option-cache"
      role="option"
      tabindex="0"
    >
      <span
        class="relative flex min-w-0 items-center gap-3 max-w-[45%] shrink-0"
      >
        <span
          aria-hidden="true"
