{
  "name": "app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n vite,bun -c blue,green \"bun run vite:dev\" \"bun run bun:dev\"",
    "vite:dev": "vite",
    "bun:dev": "bun run scripts/copy-bun-assets.ts && ELECTROBUN_DEV_URL=http://localhost:3001 electrobun dev --watch",
    "build": "vite build",
    "desktop:dev": "bun run dev",
    "desktop:package": "bun run scripts/copy-bun-assets.ts && vite build",
    "desktop:build": "bun run desktop:package && electrobun build --env=stable",
    "electrobun:prepare": "electrobun sync && bun run scripts/electrobun-types.ts",
    "postinstall": "bun run electrobun:prepare",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
    "e2e:ui": "playwright test --ui",
    "serve": "vite preview",
    "start": "vite",
    "check-types": "tsgo --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.0.0",
    "@codemirror/lang-sql": "^6.10.0",
    "@conch/agent": "workspace:*",
    "@conch/core": "workspace:*",
    "@conch/drivers": "workspace:*",
    "@conch/env": "workspace:*",
    "@conch/rpc": "workspace:*",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@fontsource-variable/mona-sans": "5.3.0",
    "@tailwindcss/vite": "^4.0.15",
    "@tanstack/react-router": "^1.141.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dotenv": "catalog:",
    "lucide-react": "^0.575.0",
    "motion": "^12.34.0",
    "next-themes": "^0.4.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "recharts": "2.15.4",
    "shadcn": "^3.8.4",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.2.5",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@conch/config": "workspace:*",
    "@playwright/test": "^1.65.1",
    "@tanstack/react-router-devtools": "^1.141.1",
    "@tanstack/router-plugin": "^1.141.1",
    "@types/bun": "catalog:",
    "@types/node": "^25.6.0",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@typescript/native-preview": "catalog:",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/browser-playwright": "^4.1.5",
    "@vitest/coverage-v8": "^4.1.5",
    "concurrently": "^9.1.0",
    "electrobun": "2.0.6",
    "jsdom": "^26.1.0",
    "playwright": "^1.65.1",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.2.4",
    "vite": "^6.2.2",
    "vitest": "catalog:",
    "vitest-browser-react": "^1.0.0"
  }
}
