{
  "name": "app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n vite,bun -c blue,green \"bun run vite:dev\" \"bun run bun:dev\"",
    "vite:dev": "vite",
    "bun:dev": "bun run scripts/copy-bun-assets.ts && ELECTROBUN_DEV_URL=http://localhost:3001 electrobun dev --watch",
    "build": "vite build",
    "desktop:dev": "bun run dev",
    "desktop:build": "bun run scripts/copy-bun-assets.ts && vite build && electrobun build",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
    "e2e:ui": "playwright test --ui",
    "serve": "vite preview",
    "start": "vite",
    "check-types": "tsgo --noEmit"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.44",
